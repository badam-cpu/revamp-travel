# Copy this file to .env and fill in the values you need.
# cp .env.example .env

# Required only to use the AI trip planner (/plan, POST /api/plan-trip).
# Server-side only — never exposed to the browser. Without it, the rest of
# the site works normally and /api/plan-trip returns a clear 503.
ANTHROPIC_API_KEY=

# Optional: override the model used for trip planning.
# Defaults to claude-sonnet-4-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: port for the Express API in development (proxied to by Vite).
# Defaults to 3001 if unset.
# API_PORT=3001

# Optional: port for the single production process (pnpm start).
# Defaults to 3000 if unset.
# PORT=3000

# --- Netlify deployment notes (no values needed here) ---
# On Netlify, set ANTHROPIC_API_KEY in the site environment instead of a .env
# file: `netlify env:set ANTHROPIC_API_KEY <value>` (or the Netlify dashboard).
# Never commit the real key.
#
# Netlify Blobs (the production listings store) needs NO credentials when
# accessed from inside a Netlify Function — it's auto-scoped to the site.
# NETLIFY is set automatically by the Functions runtime and selects the Blobs
# storage backend in server/store.ts; you do not set it yourself.
