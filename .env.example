# Copy this file to .env and fill in the values you need.
# cp .env.example .env

# Required for real accounts and real listing writes (sign-up, sign-in,
# /dashboard). Without these, the app still runs and browses using the
# static shared/listings.ts seed as a read-only fallback.
# From your Supabase project's API settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: enables the Google Places address autocomplete on the operator
# dashboard (type an address -> auto-fills city/region/coordinates). Without
# it, the dashboard just shows the manual city/region/lat/lng fields.
# A browser key from Google Cloud (enable "Places API" + "Maps JavaScript API",
# enable billing, and RESTRICT the key by HTTP referrer since Vite inlines it).
VITE_GOOGLE_MAPS_API_KEY=

# Required only to use the AI trip planner (/plan, POST /api/plan-trip).
# Server-side only — never exposed to the browser. Without it, the rest of
# the site works normally and /api/plan-trip returns a clear 503.
ANTHROPIC_API_KEY=

# Optional: override the model used for trip planning.
# Defaults to claude-sonnet-4-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: port for the Express API in development (proxied to by Vite).
# Defaults to 3001 if unset.
# API_PORT=3001

# Optional: port for the single production process (pnpm start).
# Defaults to 3000 if unset.
# PORT=3000

# --- Local, one-time use only: `pnpm seed:catalog` (scripts/seed-catalog.ts) ---
# Never used by the running app itself, client or server. Do not deploy
# these anywhere. SUPABASE_SERVICE_ROLE_KEY bypasses every Row-Level
# Security policy in the database — keep it secret.

# From the same Supabase API settings page as VITE_SUPABASE_ANON_KEY above.
SUPABASE_SERVICE_ROLE_KEY=

# Credentials for the house "Revamp" operator account — sign up for this
# account by hand at /signup (choosing "Operator") before running the seed
# script, then put its email/password here.
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=
