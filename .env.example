# Copy this file to .env and fill in the values you need.
# cp .env.example .env

# Required for real accounts and real listing writes (sign-up, sign-in,
# /dashboard). Without these, the app still runs and browses using the
# static shared/listings.ts seed as a read-only fallback.
# From your Supabase project's API settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: enables the Google Places address autocomplete on the operator
# dashboard (type an address -> auto-fills city/region/coordinates). Without
# it, PlaceAutocomplete renders nothing and the dashboard just shows the
# manual city/region/lat/lng fields, exactly as before.
# A browser key from Google Cloud: enable "Places API (New)" (not the old
# unsuffixed "Places API"), enable billing, and RESTRICT the key (HTTP-referrer
# + API restriction) since Vite inlines it into client code. See ENVIRONMENT.md.
VITE_GOOGLE_MAPS_API_KEY=

# Required only to use the AI trip planner (/plan, POST /api/plan-trip).
# Server-side only — never exposed to the browser. Without it, the rest of
# the site works normally and /api/plan-trip returns a clear 503.
ANTHROPIC_API_KEY=

# Optional: override the model used for trip planning.
# Defaults to claude-sonnet-4-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: port for the Express API in development (proxied to by Vite).
# Defaults to 3001 if unset.
# API_PORT=3001

# Optional: port for the single production process (pnpm start).
# Defaults to 3000 if unset.
# PORT=3000

# --- Supabase service role (server-side only; NEVER VITE_-prefixed) ---
# Bypasses every Row-Level Security policy — keep it secret. Two server uses:
#   1. `pnpm seed:catalog` (local, one-time) — see below.
#   2. The PayLink booking confirm/reconcile code (server/supabaseAdmin.ts):
#      SET THIS IN NETLIFY so POST /api/confirm-checkout and the reconcile/
#      iCal crons can flip bookings to `confirmed` (a write RLS can't authorize).
# It has no VITE_ prefix, so it never reaches the browser bundle.
# From the same Supabase API settings page as VITE_SUPABASE_ANON_KEY above.
SUPABASE_SERVICE_ROLE_KEY=

# Credentials for the house "Revamp" operator account — sign up for this
# account by hand at /signup (choosing "Operator") before running the seed
# script, then put its email/password here. Local/one-time only.
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=

# --- Payments: PayLink booking loop (server-side only) ---
# Without the credentials, POST /api/start-checkout returns 503 and the app
# runs normally otherwise. Set these in Netlify. Production has no sandbox —
# a completed payment is a real charge.
PAYLINK_PARTNER_ID=
PAYLINK_PARTNER_KEY=
PAYLINK_BASE_URL=https://api.paylink.am
# requestType string on Request/Register (default "1" if unset).
# PAYLINK_REQUEST_TYPE=1
# Charge currency — the marketplace is AMD-primary (listings priced, charged,
# and accounted in Armenian dram), so AMD (code defaults to AMD).
PAYLINK_CURRENCY=AMD
# Hosted checkout page language: en / hy / ru / fr (defaults to en).
# PAYLINK_LANGUAGE=en

# --- Booking emails (optional; via Resend) ---
# Without both, server/email.ts is a silent no-op — bookings still work, no
# email goes out. RESEND_API_KEY from resend.com; EMAIL_FROM must be a sender
# on a domain you've verified in Resend (see ENVIRONMENT.md).
#   e.g. EMAIL_FROM="Revamp Travel <bookings@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=

# --- SMS + WhatsApp + Viber (optional; via Infobip) ---
# Booking confirmations also text / WhatsApp / Viber the customer on top of email,
# and are mirrored into the unified inbox. Without these, server/sms.ts is a
# silent no-op (email + inbox still work). Infobip is used instead of Twilio
# because it onboards in Armenia and covers Viber (a primary channel there).
# All values come from your Infobip account — the base URL is account-specific.
# Each channel is independent: set only the FROMs you've enabled.
#   INFOBIP_BASE_URL   e.g. https://xxxxx.api.infobip.com
#   INFOBIP_SMS_FROM   registered Sender ID (Armenia requires registration, ~3–4 wks)
#   INFOBIP_VIBER_FROM registered Viber sender name
# NOTE: business-initiated WhatsApp outside the 24h window needs a pre-approved
# template — see ENVIRONMENT.md.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_FROM=
INFOBIP_WHATSAPP_FROM=
INFOBIP_VIBER_FROM=

# --- Telegram (optional; free opt-in channel) ---
# A free notification channel with no carrier onboarding. Customers link it once
# via a bot deep link (Account → Connect Telegram); then their confirmations are
# delivered free. Create a bot with @BotFather → token + @username. After deploy,
# an admin calls POST /api/telegram/set-webhook once to register the webhook.
# TELEGRAM_WEBHOOK_SECRET is optional but recommended (validates incoming updates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google Analytics 4 (optional). Create a GA4 property, paste its Measurement ID
# (G-XXXXXXXXXX). Analytics only loads when this is set. Also set it in Netlify.
VITE_GA_MEASUREMENT_ID=
